{
  "name": "@roundtable/knight-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared runtime pieces for the knights",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "contract:export": "tsx scripts/export-contract.ts"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/kv": "^3.5.0",
    "@nats-io/services": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "prom-client": "^15.1.3",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./nats": {
      "types": "./dist/nats/index.d.ts",
      "default": "./dist/nats/index.js"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "default": "./dist/activity.js"
    },
    "./contract/fixtures": {
      "types": "./dist/contract/fixtures.d.ts",
      "default": "./dist/contract/fixtures.js"
    }
  },
  "files": [
    "dist",
    "contract"
  ]
}
