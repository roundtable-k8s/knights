{
  "name": "claude-knight",
  "version": "0.1.0",
  "description": "Claude Code knight runtime for the Round Table \u2014 runs tasks through the official Claude Code CLI (headless) on a Claude plan, or the Agent SDK with an API key",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.329",
    "@roundtable/knight-core": "*",
    "nats": "^2.29.3",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
