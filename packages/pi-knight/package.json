{
  "name": "pi-knight",
  "version": "0.1.0",
  "description": "Universal base agent runtime for the Knights of the Round Table",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --import ../../scripts/test/hermetic-env.ts tests/**/*.test.ts",
    "test:hermetic": "ROUNDTABLE_TABLE=x KNIGHT_NAME=y NATS_URL=nats://127.0.0.1:4222 METRICS_PORT=3000 OTEL_SDK_DISABLED=false SUBSCRIBE_TOPICS=rt.tasks.x TASK_TIMEOUT_MS=1000 POD_NAMESPACE=x npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@roundtable/knight-core": "*",
    "prom-client": "^15.1.3",
    "typebox": "^1.3.27",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
